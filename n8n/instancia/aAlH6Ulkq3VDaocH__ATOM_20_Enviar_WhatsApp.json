      {
        "id": "bfcbb6d7-39af-4074-aa7b-fb2ce3cd136d",
        "name": "Decidir envio",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          672,
          80
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const cfg = {};\nfor (const i of $('Ler configuração').all()) { const r = i.json || {}; if (r.chave) cfg[r.chave] = { valor: String(r.valor ?? '').trim(), status: String(r.status || '').toUpperCase() }; }\nconst val = (k, d) => (cfg[k] && cfg[k].valor && cfg[k].status !== 'PENDENTE' && cfg[k].status !== 'OBSOLETO' ? cfg[k].valor : d);\nconst p = $('Pedido de envio').first().json;\nconst numero = String(p.numero || '').trim();\nconst tel = String(p.telefone || '').replace(/\\D/g, '');\nconst texto = String(p.texto || '').trim();\nconst modelo = String(p.modelo_nome || '').trim();\nconst params = Array.isArray(p.modelo_parametros) ? p.modelo_parametros : [];\nconst agora = Date.now();\nconst ultimaIn = $input.all().map((i) => i.json || {}).reduce((m, r) => Math.max(m, Date.parse(r.criado_em) || 0), 0);\nconst janelaAberta = ultimaIn > 0 && (agora - ultimaIn) < (24 * 3600 - 300) * 1000;\nconst modo = val('MODO_EXECUCAO', 'SIMULACAO').toUpperCase();\nconst phoneId = val(numero === '2' ? 'WA_N2_PHONE_ID' : 'WA_N1_PHONE_ID', '');\nconst versao = val('WA_GRAPH_VERSAO', 'v21.0');\nconst sandboxTels = val('WA_SANDBOX_TELEFONES', '').split(',').map((s) => s.replace(/\\D/g, '')).filter(Boolean);\nconst toque = String(p.toque || '').toUpperCase();\nconst seguemReuniao = ['R4', 'R5', 'O3', 'O4'].includes(toque);\nlet dentroHorario = true;\nif (!p.eh_resposta && !seguemReuniao) {\n  const hc = val('HORARIO_COMERCIAL', '09:00-18:00;1,2,3,4,5');\n  const partes = hc.split(';'); const hs = partes[0].split('-');\n  const min = (x) => { const q = x.split(':'); return Number(q[0]) * 60 + Number(q[1] || 0); };\n  const dias = (partes[1] || '1,2,3,4,5').split(',').map(Number);\n  const loc = new Date(agora - 3 * 3600000);\n  const dow = loc.getUTCDay() === 0 ? 7 : loc.getUTCDay();\n  const m = loc.getUTCHours() * 60 + loc.getUTCMinutes();\n  dentroHorario = dias.includes(dow) && m >= min(hs[0]) && m < min(hs[1]);\n}\nlet decisao = 'ENVIAR'; let motivo = '';\nif (!tel) { decisao = 'BLOQUEADA'; motivo = 'Sem telefone'; }\nelse if (!texto && !modelo) { decisao = 'BLOQUEADA'; motivo = 'Sem texto e sem modelo'; }\nelse if (!phoneId) { decisao = 'BLOQUEADA'; motivo = 'WA_N' + (numero === '2' ? '2' : '1') + '_PHONE_ID não configurado'; }\nelse if (!dentroHorario) { decisao = 'ADIADA'; motivo = 'Fora do horário comercial'; }\nelse if (!janelaAberta && !modelo) { decisao = 'BLOQUEADA'; motivo = 'Janela de 24h fechada e nenhum modelo aprovado informado'; }\nif (decisao === 'ENVIAR' && modo === 'SIMULACAO') { decisao = 'SIMULADA'; motivo = 'MODO_EXECUCAO=SIMULACAO'; }\nif (decisao === 'ENVIAR' && modo === 'SANDBOX' && !sandboxTels.includes(tel)) { decisao = 'SIMULADA'; motivo = 'SANDBOX: telefone fora de WA_SANDBOX_TELEFONES'; }\nconst usarTexto = janelaAberta && texto;\nconst payload = usarTexto\n  ? { messaging_product: 'whatsapp', recipient_type: 'individual', to: tel, type: 'text', text: { preview_url: true, body: texto } }\n  : { messaging_product: 'whatsapp', recipient_type: 'individual', to: tel, type: 'template', template: { name: modelo, language: { code: val('WA_MODELO_IDIOMA', 'pt_BR') }, components: params.length ? [{ type: 'body', parameters: params.map((x) => ({ type: 'text', text: String(x) })) }] : [] } };\nreturn [{ json: {\n  decisao, motivo, numero, telefone: tel, deal_id: Number(p.deal_id) || 0, toque, gancho: String(p.gancho || ''),\n  texto_registro: usarTexto ? texto : ('[modelo ' + modelo + '] ' + params.join(' | ')),\n  janela_aberta: janelaAberta, phone_id: phoneId, graph_versao: versao, payload, wa_message_id: ''\n} }];"
        }
      },
