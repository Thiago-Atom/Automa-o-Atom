      {
        "id": "60603a35-8f8b-49d6-b009-44c72c5946a0",
        "name": "Resultado do envio",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1344,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const d = $('Decidir envio').first().json;\nconst r = $input.first().json || {};\nconst ok = r.statusCode >= 200 && r.statusCode < 300;\nconst id = ok && r.body && r.body.messages && r.body.messages[0] ? r.body.messages[0].id : '';\nreturn [{ json: Object.assign({}, d, { decisao: ok ? 'ENVIADA' : 'ERRO', motivo: ok ? '' : ('Meta HTTP ' + r.statusCode + ' ' + JSON.stringify(r.body || {}).slice(0, 300)), wa_message_id: id }) }];"
        }
