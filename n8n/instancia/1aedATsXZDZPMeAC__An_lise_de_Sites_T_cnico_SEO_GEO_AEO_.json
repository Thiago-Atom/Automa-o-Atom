        "parameters": {
          "formTitle": "Análise de Site",
          "formDescription": "Informe a URL do site, o termo principal e o cliente no CRM para gerar a análise técnica + SEO/GEO/AEO.",
          "formFields": {
            "values": [
              {
                "fieldLabel": "URL do site",
                "fieldName": "site_url",
                "fieldType": "text",
                "requiredField": true,
                "placeholder": "https://exemplo.com.br"
              },
              {
                "fieldLabel": "Termo / palavra-chave principal",
                "fieldName": "keyword",
                "fieldType": "text",
                "requiredField": true,
                "placeholder": "ex.: consultoria de marketing"
              },
              {
                "fieldLabel": "ID do cliente no CRM",
                "fieldName": "client_id",
                "fieldType": "text",
                "requiredField": true
              },
              {
                "fieldLabel": "Nome do cliente",
