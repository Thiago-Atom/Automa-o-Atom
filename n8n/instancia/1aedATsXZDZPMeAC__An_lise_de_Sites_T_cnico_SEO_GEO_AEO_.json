      {
        "id": "bab568f1-4a80-429f-91ed-272d35c34cd1",
        "name": "Análise com Claude",
        "type": "@n8n/n8n-nodes-langchain.anthropic",
        "typeVersion": 1,
        "position": [
          896,
          0
        ],
        "parameters": {
          "resource": "text",
          "operation": "message",
          "modelId": {
            "__rl": true,
            "mode": "list",
            "value": "claude-sonnet-4-20250514",
            "cachedResultName": "Claude Sonnet 4"
          },
          "simplify": true,
          "messages": {
            "values": [
              {
                "role": "user",
                "content": "=Analise o site abaixo e produza um relatório completo em HTML (apenas o HTML do <body>, sem markdown, sem crases).\n\nSITE ALVO: {{ $(\"Formulário de Análise\").item.json.site_url }}\nTERMO PRINCIPAL: {{ $(\"Formulário de Análise\").item.json.keyword }}\nCLIENTE: {{ $(\"Formulário de Análise\").item.json.client_name }}\n\nCONTEÚDO COLETADO DO SITE (Firecrawl):\n{{ JSON.stringify($(\"Coletar Conteúdo do Site\").item.json) }}\n\nRESULTADOS DE BUSCA / CONCORRENTES (Brave SERP):\n{{ JSON.stringify($(\"Buscar Concorrentes (SERP)\").item.json) }}\n\nMÉTRICAS DA PALAVRA-CHAVE:\n{{ JSON.stringify($(\"Volume de Oportunidade (Keyword API)\").item.json) }}"
              }
            ]
          },
          "options": {
            "maxTokens": 4096,
            "temperature": 0.4,
            "system": "Você é um consultor sênior de web, UX e SEO. Produza um relatório profissional em HTML bem estruturado (headings, tabelas, listas) cobrindo, para o cliente: 1) TÉCNICO/ARQUITETURA DA INFORMAÇÃO — estrutura, navegação, hierarquia, performance percebida; 2) DESIGN — layout, consistência visual, responsividade, acessibilidade; 3) COPY — clareza, proposta de valor, CTAs, tom de voz; 4) SEO — on-page, títulos, meta, headings, links, indexabilidade; 5) GEO (Generative Engine Optimization) — como o site aparece/aparecerá em respostas de IA; 6) AEO (Answer Engine Optimization) — dados estruturados, featured snippets, perguntas e respostas; 7) ANÁLISE DOS 5 MAIORES CONCORRENTES a partir dos resultados de busca, comparando pontos fortes/fracos; 8) VOLUME DE OPORTUNIDADE do termo — interprete o volume/dificuldade/CPC e estime o potencial. Termine com um plano de ação priorizado (quick wins e médio prazo). Responda em português do Brasil. Retorne SOMENTE o HTML do corpo do relatório."
          }
        }
      },
      {
        "id": "c1d1c256-b211-4b98-91c3-a284c1e646da",
        "name": "Preparar HTML do Relatório",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1120,
          0
        ],
        "parameters": {
          "jsCode": "const res = $input.first().json;\nlet body = '';\nif (Array.isArray(res.content)) { body = res.content.map(b => b.text || b.content || '').join('\\n'); }\nelse if (typeof res.content === 'string') { body = res.content; }\nelse if (res.text) { body = res.text; }\nelse if (res.output) { body = res.output; }\nconst form = $('Formulário de Análise').first().json;\nconst safe = String(form.site_url || 'site').replace(/[^a-z0-9]/gi, '_').slice(0, 60);\nconst today = new Date().toISOString().slice(0, 10);\nconst html = '<!DOCTYPE html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><style>body{font-family:Arial,Helvetica,sans-serif;color:#222;line-height:1.5;padding:32px;}h1{color:#1a1a2e;}table{border-collapse:collapse;width:100%;}th,td{border:1px solid #ccc;padding:6px;text-align:left;}</style></head><body>' + body + '<hr><p style=\"color:#888;font-size:12px;\">Gerado em ' + today + ' — ' + form.site_url + '</p></body></html>';\nreturn [{ json: { html, client_id: form.client_id, client_name: form.client_name || '', site_url: form.site_url, keyword: form.keyword, filename: 'analise-' + safe + '-' + today + '.pdf' } }];"
        }
      },
      {
        "id": "9d11d752-fb7e-47cb-baaa-f2f773f87979",
        "name": "Gerar PDF (HTML→PDF)",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
