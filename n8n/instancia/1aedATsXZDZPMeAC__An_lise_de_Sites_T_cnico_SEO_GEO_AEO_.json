          0
        ],
        "parameters": {
          "method": "POST",
          "url": "<__PLACEHOLDER_VALUE__Endpoint do serviço HTML→PDF (ex.: PDFShift/Api2PDF)__>",
          "sendBody": true,
          "contentType": "json",
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ source: $json.html, landscape: false, format: \"A4\" }) }}",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpTemplatedCustomAuth",
          "options": {
            "response": {
              "response": {
                "responseFormat": "file",
                "outputPropertyName": "data"
              }
            }
          }
        }
      },
