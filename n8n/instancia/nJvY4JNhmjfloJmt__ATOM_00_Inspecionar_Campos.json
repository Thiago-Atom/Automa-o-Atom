        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const ents = $('Entidades').all().map((i) => i.json.entidade);\nconst out = [];\n$input.all().forEach((it, idx) => {\n  for (const f of (it.json.data || [])) {\n    if (/^ATOM\\s*[·\\.\\-]/i.test(String(f.name || ''))) out.push({ json: { entidade: ents[idx], nome: f.name, key: f.key, tipo: f.field_type } });\n  }\n});\nreturn out.length ? out : [{ json: { vazio: true } }];"
