        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Todos os projetos do Semrush com Site Audit ou Position Tracking entram na auditoria (novos projetos entram sozinhos)\nconst j = $input.first().json || {};\nlet x = j.result !== undefined ? j.result : j;\nif (x && x.structuredContent !== undefined) x = x.structuredContent;\nelse if (x && Array.isArray(x.content)) { const p = x.content.map((c) => c.text); x = p.length === 1 ? p[0] : p.join(''); }\nif (x && typeof x === 'object' && !Array.isArray(x) && x.data !== undefined) x = x.data;\nif (typeof x === 'string') { try { x = JSON.parse(x); } catch (e) { x = []; } }\nlet lista = Array.isArray(x) ? x : ((x && (x.projects || x.result)) || []);\nconst inicio = new Date().toISOString();\nreturn lista\n  .filter((p) => p && p.url && (p.tools || []).some((t) => t.tool === 'siteaudit' || t.tool === 'tracking'))\n  .map((p) => ({ json: { projectId: String(p.project_id), nome: p.project_name, dominio: p.url, inicioExecucao: inicio } }));"
        }
      },
