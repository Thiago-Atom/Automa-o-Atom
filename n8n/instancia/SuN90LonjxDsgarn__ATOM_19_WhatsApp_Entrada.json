      {
        "id": "1ee6661f-2654-4600-8bae-a2b5bfd30f61",
        "name": "Extrair mensagens novas",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          448,
          512
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const cfg = {};\nfor (const i of $('Ler configuração').all()) { const r = i.json || {}; if (r.chave) cfg[r.chave] = { valor: String(r.valor ?? '').trim(), status: String(r.status || '').toUpperCase() }; }\nconst val = (k, d) => (cfg[k] && cfg[k].valor && cfg[k].status !== 'PENDENTE' && cfg[k].status !== 'OBSOLETO' ? cfg[k].valor : d);\nconst n1 = val('WA_N1_PHONE_ID', ''); const n2 = val('WA_N2_PHONE_ID', '');\nconst body = $('Webhook da Meta').first().json.body || {};\nconst FORMATOS = { audio: 'um áudio', image: 'uma imagem', video: 'um vídeo', document: 'um documento', sticker: 'uma figurinha', location: 'uma localização', contacts: 'um contato' };\nconst out = [];\nfor (const e of (body.entry || [])) for (const ch of (e.changes || [])) {\n  const v = ch.value || {};\n  const pid = String((v.metadata || {}).phone_number_id || '');\n  const numero = pid && pid === n2 ? '2' : (pid && pid === n1 ? '1' : '');\n  if (!numero) continue;\n  const nomes = {};\n  for (const c of (v.contacts || [])) nomes[c.wa_id] = (c.profile || {}).name || '';\n  for (const m of (v.messages || [])) {\n    let texto = '';\n    if (m.type === 'text') texto = (m.text || {}).body || '';\n    else if (m.type === 'button') texto = (m.button || {}).text || '';\n    else if (m.type === 'interactive') { const it = m.interactive || {}; texto = (it.button_reply || {}).title || (it.list_reply || {}).title || ''; }\n    else texto = '[O cliente enviou ' + (FORMATOS[m.type] || ('uma mensagem do tipo ' + m.type)) + '. A IA ainda não lê esse formato: peça, com gentileza, que ele escreva.]';\n    out.push({ numero, telefone: String(m.from || ''), nome_perfil: nomes[m.from] || '', texto, wa_message_id: String(m.id || ''), tipo: m.type });\n  }\n}\nconst st = $getWorkflowStaticData('global');\nst.vistos = st.vistos || [];\nconst novos = out.filter((x) => x.wa_message_id && !st.vistos.includes(x.wa_message_id));\nst.vistos = st.vistos.concat(novos.map((x) => x.wa_message_id)).slice(-2000);\nreturn novos.map((x) => ({ json: x }));"
        }
      },
