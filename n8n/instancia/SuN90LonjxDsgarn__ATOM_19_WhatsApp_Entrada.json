        "id": "002337b5-fe6c-454d-b26b-2d933100716f",
        "name": "Conferir token",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          448,
          96
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "let token = '';\nfor (const i of $('Ler configuração (verificação)').all()) { const r = i.json || {}; if (r.chave === 'WA_VERIFY_TOKEN' && String(r.status || '').toUpperCase() !== 'PENDENTE') token = String(r.valor || '').trim(); }\nconst q = $('Verificação da Meta').first().json.query || {};\nconst ok = !!token && q['hub.mode'] === 'subscribe' && q['hub.verify_token'] === token;\nreturn [{ json: { ok, challenge: String(q['hub.challenge'] || '') } }];"
        }
      },
